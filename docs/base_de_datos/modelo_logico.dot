digraph ER {
graph [rankdir=LR, splines=true, nodesep=0.45, ranksep=1.1, fontname="Arial", pad=0.4, label=<<B>PetCare – Modelo lógico final de la base de datos (Supabase / PostgreSQL)</B><BR/><FONT POINT-SIZE="11">PK = llave primaria · FK = llave foránea · UQ = única · NN = no nulo</FONT>>, labelloc=t, fontsize=20];
node [shape=plaintext, fontname="Arial", fontsize=10]; edge [color="#455A64", penwidth=1.2, dir=both];
subgraph "cluster_Usuarios y auditoría" { label=<<B>Usuarios y auditoría</B>>; style="rounded,filled"; fillcolor="#E3F2FD"; color="#1565C0"; fontcolor="#1565C0"; fontsize=14;
"perfiles" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white" COLOR="#1565C0"><TR><TD COLSPAN="3" BGCOLOR="#1565C0" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="13"><B>PERFILES</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="perfil_id_l"><FONT POINT-SIZE="9" COLOR="#1565C0"><B>PK, FK</B></FONT></TD><TD ALIGN="LEFT"><B><U>perfil_id</U></B></TD><TD ALIGN="LEFT" PORT="perfil_id"><FONT POINT-SIZE="9" COLOR="#607D8B">UUID NN</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="nombre_completo_l"> </TD><TD ALIGN="LEFT">nombre_completo</TD><TD ALIGN="LEFT" PORT="nombre_completo"><FONT POINT-SIZE="9" COLOR="#607D8B">VARCHAR(150) NN</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="telefono_l"> </TD><TD ALIGN="LEFT">telefono</TD><TD ALIGN="LEFT" PORT="telefono"><FONT POINT-SIZE="9" COLOR="#607D8B">VARCHAR(20)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="documento_identidad_l"> </TD><TD ALIGN="LEFT">documento_identidad</TD><TD ALIGN="LEFT" PORT="documento_identidad"><FONT POINT-SIZE="9" COLOR="#607D8B">VARCHAR(20)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="direccion_l"> </TD><TD ALIGN="LEFT">direccion</TD><TD ALIGN="LEFT" PORT="direccion"><FONT POINT-SIZE="9" COLOR="#607D8B">TEXT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="rol_l"> </TD><TD ALIGN="LEFT">rol</TD><TD ALIGN="LEFT" PORT="rol"><FONT POINT-SIZE="9" COLOR="#607D8B">VARCHAR(20) NN</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="fecha_registro_l"> </TD><TD ALIGN="LEFT">fecha_registro</TD><TD ALIGN="LEFT" PORT="fecha_registro"><FONT POINT-SIZE="9" COLOR="#607D8B">TIMESTAMPTZ NN</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="estado_cuenta_l"> </TD><TD ALIGN="LEFT">estado_cuenta</TD><TD ALIGN="LEFT" PORT="estado_cuenta"><FONT POINT-SIZE="9" COLOR="#607D8B">VARCHAR(20) NN</FONT></TD></TR></TABLE>>];
"historial_cambios" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white" COLOR="#1565C0"><TR><TD COLSPAN="3" BGCOLOR="#1565C0" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="13"><B>HISTORIAL_CAMBIOS</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="historial_cambio_id_l"><FONT POINT-SIZE="9" COLOR="#1565C0"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><B><U>historial_cambio_id</U></B></TD><TD ALIGN="LEFT" PORT="historial_cambio_id"><FONT POINT-SIZE="9" COLOR="#607D8B">BIGINT NN</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="usuario_id_l"><FONT POINT-SIZE="9" COLOR="#1565C0"><B>FK</B></FONT></TD><TD ALIGN="LEFT"><I>usuario_id</I></TD><TD ALIGN="LEFT" PORT="usuario_id"><FONT POINT-SIZE="9" COLOR="#607D8B">UUID NN</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="rol_usuario_l"> </TD><TD ALIGN="LEFT">rol_usuario</TD><TD ALIGN="LEFT" PORT="rol_usuario"><FONT POINT-SIZE="9" COLOR="#607D8B">VARCHAR(20) NN</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="atencion_id_l"><FONT POINT-SIZE="9" COLOR="#1565C0"><B>FK</B></FONT></TD><TD ALIGN="LEFT"><I>atencion_id</I></TD><TD ALIGN="LEFT" PORT="atencion_id"><FONT POINT-SIZE="9" COLOR="#607D8B">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="actividad_id_l"><FONT POINT-SIZE="9" COLOR="#1565C0"><B>FK</B></FONT></TD><TD ALIGN="LEFT"><I>actividad_id</I></TD><TD ALIGN="LEFT" PORT="actividad_id"><FONT POINT-SIZE="9" COLOR="#607D8B">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="tipo_accion_l"> </TD><TD ALIGN="LEFT">tipo_accion</TD><TD ALIGN="LEFT" PORT="tipo_accion"><FONT POINT-SIZE="9" COLOR="#607D8B">VARCHAR(20) NN</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="datos_anteriores_l"> </TD><TD ALIGN="LEFT">datos_anteriores</TD><TD ALIGN="LEFT" PORT="datos_anteriores"><FONT POINT-SIZE="9" COLOR="#607D8B">JSONB</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="datos_nuevos_l"> </TD><TD ALIGN="LEFT">datos_nuevos</TD><TD ALIGN="LEFT" PORT="datos_nuevos"><FONT POINT-SIZE="9" COLOR="#607D8B">JSONB</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="fecha_cambio_l"> </TD><TD ALIGN="LEFT">fecha_cambio</TD><TD ALIGN="LEFT" PORT="fecha_cambio"><FONT POINT-SIZE="9" COLOR="#607D8B">TIMESTAMPTZ NN</FONT></TD></TR></TABLE>>];
}
subgraph "cluster_Propietarios, mascotas y citas" { label=<<B>Propietarios, mascotas y citas</B>>; style="rounded,filled"; fillcolor="#FFF3E0"; color="#E65100"; fontcolor="#E65100"; fontsize=14;
"propietarios" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white" COLOR="#E65100"><TR><TD COLSPAN="3" BGCOLOR="#E65100" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="13"><B>PROPIETARIOS</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="propietario_id_l"><FONT POINT-SIZE="9" COLOR="#E65100"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><B><U>propietario_id</U></B></TD><TD ALIGN="LEFT" PORT="propietario_id"><FONT POINT-SIZE="9" COLOR="#607D8B">BIGINT NN</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="nombre_l"> </TD><TD ALIGN="LEFT">nombre</TD><TD ALIGN="LEFT" PORT="nombre"><FONT POINT-SIZE="9" COLOR="#607D8B">VARCHAR(100) NN</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="apellido_l"> </TD><TD ALIGN="LEFT">apellido</TD><TD ALIGN="LEFT" PORT="apellido"><FONT POINT-SIZE="9" COLOR="#607D8B">VARCHAR(100) NN</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="documento_identidad_l"><FONT POINT-SIZE="9" COLOR="#E65100"><B>UQ</B></FONT></TD><TD ALIGN="LEFT">documento_identidad</TD><TD ALIGN="LEFT" PORT="documento_identidad"><FONT POINT-SIZE="9" COLOR="#607D8B">VARCHAR(20) NN</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="telefono_l"> </TD><TD ALIGN="LEFT">telefono</TD><TD ALIGN="LEFT" PORT="telefono"><FONT POINT-SIZE="9" COLOR="#607D8B">VARCHAR(20) NN</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="correo_l"> </TD><TD ALIGN="LEFT">correo</TD><TD ALIGN="LEFT" PORT="correo"><FONT POINT-SIZE="9" COLOR="#607D8B">VARCHAR(150)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="direccion_l"> </TD><TD ALIGN="LEFT">direccion</TD><TD ALIGN="LEFT" PORT="direccion"><FONT POINT-SIZE="9" COLOR="#607D8B">TEXT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="estado_l"> </TD><TD ALIGN="LEFT">estado</TD><TD ALIGN="LEFT" PORT="estado"><FONT POINT-SIZE="9" COLOR="#607D8B">VARCHAR(20) NN</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="fecha_registro_l"> </TD><TD ALIGN="LEFT">fecha_registro</TD><TD ALIGN="LEFT" PORT="fecha_registro"><FONT POINT-SIZE="9" COLOR="#607D8B">TIMESTAMPTZ NN</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="observaciones_l"> </TD><TD ALIGN="LEFT">observaciones</TD><TD ALIGN="LEFT" PORT="observaciones"><FONT POINT-SIZE="9" COLOR="#607D8B">TEXT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="motivo_desactivacion_l"> </TD><TD ALIGN="LEFT">motivo_desactivacion</TD><TD ALIGN="LEFT" PORT="motivo_desactivacion"><FONT POINT-SIZE="9" COLOR="#607D8B">TEXT</FONT></TD></TR></TABLE>>];
"mascotas" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white" COLOR="#E65100"><TR><TD COLSPAN="3" BGCOLOR="#E65100" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="13"><B>MASCOTAS</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="propietario_id_l"><FONT POINT-SIZE="9" COLOR="#E65100"><B>FK</B></FONT></TD><TD ALIGN="LEFT"><I>propietario_id</I></TD><TD ALIGN="LEFT" PORT="propietario_id"><FONT POINT-SIZE="9" COLOR="#607D8B">BIGINT NN</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="numero_historia_l"><FONT POINT-SIZE="9" COLOR="#E65100"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><B><U>numero_historia</U></B></TD><TD ALIGN="LEFT" PORT="numero_historia"><FONT POINT-SIZE="9" COLOR="#607D8B">VARCHAR(30) NN</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="nombre_l"> </TD><TD ALIGN="LEFT">nombre</TD><TD ALIGN="LEFT" PORT="nombre"><FONT POINT-SIZE="9" COLOR="#607D8B">VARCHAR(100) NN</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="especie_l"> </TD><TD ALIGN="LEFT">especie</TD><TD ALIGN="LEFT" PORT="especie"><FONT POINT-SIZE="9" COLOR="#607D8B">VARCHAR(50) NN</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="raza_l"> </TD><TD ALIGN="LEFT">raza</TD><TD ALIGN="LEFT" PORT="raza"><FONT POINT-SIZE="9" COLOR="#607D8B">VARCHAR(100)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="sexo_l"> </TD><TD ALIGN="LEFT">sexo</TD><TD ALIGN="LEFT" PORT="sexo"><FONT POINT-SIZE="9" COLOR="#607D8B">VARCHAR(20)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="fecha_nacimiento_l"> </TD><TD ALIGN="LEFT">fecha_nacimiento</TD><TD ALIGN="LEFT" PORT="fecha_nacimiento"><FONT POINT-SIZE="9" COLOR="#607D8B">DATE</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="estado_l"> </TD><TD ALIGN="LEFT">estado</TD><TD ALIGN="LEFT" PORT="estado"><FONT POINT-SIZE="9" COLOR="#607D8B">VARCHAR(20) NN</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="fecha_registro_l"> </TD><TD ALIGN="LEFT">fecha_registro</TD><TD ALIGN="LEFT" PORT="fecha_registro"><FONT POINT-SIZE="9" COLOR="#607D8B">TIMESTAMPTZ NN</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="color_l"> </TD><TD ALIGN="LEFT">color</TD><TD ALIGN="LEFT" PORT="color"><FONT POINT-SIZE="9" COLOR="#607D8B">VARCHAR(50)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="estado_esterilizacion_l"> </TD><TD ALIGN="LEFT">estado_esterilizacion</TD><TD ALIGN="LEFT" PORT="estado_esterilizacion"><FONT POINT-SIZE="9" COLOR="#607D8B">VARCHAR(20) NN</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="motivo_desactivacion_l"> </TD><TD ALIGN="LEFT">motivo_desactivacion</TD><TD ALIGN="LEFT" PORT="motivo_desactivacion"><FONT POINT-SIZE="9" COLOR="#607D8B">TEXT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="desactivada_por_propietario_l"> </TD><TD ALIGN="LEFT">desactivada_por_propietario</TD><TD ALIGN="LEFT" PORT="desactivada_por_propietario"><FONT POINT-SIZE="9" COLOR="#607D8B">BOOLEAN NN</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="observaciones_l"> </TD><TD ALIGN="LEFT">observaciones</TD><TD ALIGN="LEFT" PORT="observaciones"><FONT POINT-SIZE="9" COLOR="#607D8B">TEXT</FONT></TD></TR></TABLE>>];
"citas" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white" COLOR="#E65100"><TR><TD COLSPAN="3" BGCOLOR="#E65100" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="13"><B>CITAS</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="cita_id_l"><FONT POINT-SIZE="9" COLOR="#E65100"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><B><U>cita_id</U></B></TD><TD ALIGN="LEFT" PORT="cita_id"><FONT POINT-SIZE="9" COLOR="#607D8B">BIGINT NN</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="numero_historia_l"><FONT POINT-SIZE="9" COLOR="#E65100"><B>FK</B></FONT></TD><TD ALIGN="LEFT"><I>numero_historia</I></TD><TD ALIGN="LEFT" PORT="numero_historia"><FONT POINT-SIZE="9" COLOR="#607D8B">VARCHAR(30) NN</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="fecha_programada_l"> </TD><TD ALIGN="LEFT">fecha_programada</TD><TD ALIGN="LEFT" PORT="fecha_programada"><FONT POINT-SIZE="9" COLOR="#607D8B">DATE NN</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="hora_cita_l"> </TD><TD ALIGN="LEFT">hora_cita</TD><TD ALIGN="LEFT" PORT="hora_cita"><FONT POINT-SIZE="9" COLOR="#607D8B">TIME NN</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="estado_confirmacion_l"> </TD><TD ALIGN="LEFT">estado_confirmacion</TD><TD ALIGN="LEFT" PORT="estado_confirmacion"><FONT POINT-SIZE="9" COLOR="#607D8B">VARCHAR(40) NN</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="fecha_registro_l"> </TD><TD ALIGN="LEFT">fecha_registro</TD><TD ALIGN="LEFT" PORT="fecha_registro"><FONT POINT-SIZE="9" COLOR="#607D8B">TIMESTAMPTZ NN</FONT></TD></TR></TABLE>>];
"detalle_cita" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white" COLOR="#E65100"><TR><TD COLSPAN="3" BGCOLOR="#E65100" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="13"><B>DETALLE_CITA</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="detalle_cita_id_l"><FONT POINT-SIZE="9" COLOR="#E65100"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><B><U>detalle_cita_id</U></B></TD><TD ALIGN="LEFT" PORT="detalle_cita_id"><FONT POINT-SIZE="9" COLOR="#607D8B">BIGINT NN</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="cita_id_l"><FONT POINT-SIZE="9" COLOR="#E65100"><B>FK</B></FONT></TD><TD ALIGN="LEFT"><I>cita_id</I></TD><TD ALIGN="LEFT" PORT="cita_id"><FONT POINT-SIZE="9" COLOR="#607D8B">BIGINT NN</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="motivo_servicio_l"> </TD><TD ALIGN="LEFT">motivo_servicio</TD><TD ALIGN="LEFT" PORT="motivo_servicio"><FONT POINT-SIZE="9" COLOR="#607D8B">VARCHAR(255) NN</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="descripcion_servicio_l"> </TD><TD ALIGN="LEFT">descripcion_servicio</TD><TD ALIGN="LEFT" PORT="descripcion_servicio"><FONT POINT-SIZE="9" COLOR="#607D8B">TEXT</FONT></TD></TR></TABLE>>];
}
subgraph "cluster_Atenciones y actividades" { label=<<B>Atenciones y actividades</B>>; style="rounded,filled"; fillcolor="#E8F5E9"; color="#2E7D32"; fontcolor="#2E7D32"; fontsize=14;
"atenciones" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white" COLOR="#2E7D32"><TR><TD COLSPAN="3" BGCOLOR="#2E7D32" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="13"><B>ATENCIONES</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="atencion_id_l"><FONT POINT-SIZE="9" COLOR="#2E7D32"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><B><U>atencion_id</U></B></TD><TD ALIGN="LEFT" PORT="atencion_id"><FONT POINT-SIZE="9" COLOR="#607D8B">BIGINT NN</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="fecha_inicio_l"> </TD><TD ALIGN="LEFT">fecha_inicio</TD><TD ALIGN="LEFT" PORT="fecha_inicio"><FONT POINT-SIZE="9" COLOR="#607D8B">TIMESTAMPTZ NN</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="fecha_fin_l"> </TD><TD ALIGN="LEFT">fecha_fin</TD><TD ALIGN="LEFT" PORT="fecha_fin"><FONT POINT-SIZE="9" COLOR="#607D8B">TIMESTAMPTZ</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="estado_l"> </TD><TD ALIGN="LEFT">estado</TD><TD ALIGN="LEFT" PORT="estado"><FONT POINT-SIZE="9" COLOR="#607D8B">VARCHAR(20) NN</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="observaciones_l"> </TD><TD ALIGN="LEFT">observaciones</TD><TD ALIGN="LEFT" PORT="observaciones"><FONT POINT-SIZE="9" COLOR="#607D8B">TEXT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="numero_historia_l"><FONT POINT-SIZE="9" COLOR="#2E7D32"><B>FK</B></FONT></TD><TD ALIGN="LEFT"><I>numero_historia</I></TD><TD ALIGN="LEFT" PORT="numero_historia"><FONT POINT-SIZE="9" COLOR="#607D8B">VARCHAR(20) NN</FONT></TD></TR></TABLE>>];
"tipos_actividad" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white" COLOR="#2E7D32"><TR><TD COLSPAN="3" BGCOLOR="#2E7D32" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="13"><B>TIPOS_ACTIVIDAD</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="tipo_id_l"><FONT POINT-SIZE="9" COLOR="#2E7D32"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><B><U>tipo_id</U></B></TD><TD ALIGN="LEFT" PORT="tipo_id"><FONT POINT-SIZE="9" COLOR="#607D8B">BIGINT NN</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="codigo_l"><FONT POINT-SIZE="9" COLOR="#2E7D32"><B>UQ</B></FONT></TD><TD ALIGN="LEFT">codigo</TD><TD ALIGN="LEFT" PORT="codigo"><FONT POINT-SIZE="9" COLOR="#607D8B">VARCHAR(30) NN</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="nombre_l"> </TD><TD ALIGN="LEFT">nombre</TD><TD ALIGN="LEFT" PORT="nombre"><FONT POINT-SIZE="9" COLOR="#607D8B">VARCHAR(60) NN</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="activo_l"> </TD><TD ALIGN="LEFT">activo</TD><TD ALIGN="LEFT" PORT="activo"><FONT POINT-SIZE="9" COLOR="#607D8B">BOOLEAN NN</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="fecha_registro_l"> </TD><TD ALIGN="LEFT">fecha_registro</TD><TD ALIGN="LEFT" PORT="fecha_registro"><FONT POINT-SIZE="9" COLOR="#607D8B">TIMESTAMPTZ NN</FONT></TD></TR></TABLE>>];
"actividades" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white" COLOR="#2E7D32"><TR><TD COLSPAN="3" BGCOLOR="#2E7D32" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="13"><B>ACTIVIDADES</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="actividad_id_l"><FONT POINT-SIZE="9" COLOR="#2E7D32"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><B><U>actividad_id</U></B></TD><TD ALIGN="LEFT" PORT="actividad_id"><FONT POINT-SIZE="9" COLOR="#607D8B">BIGINT NN</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="atencion_id_l"><FONT POINT-SIZE="9" COLOR="#2E7D32"><B>FK</B></FONT></TD><TD ALIGN="LEFT"><I>atencion_id</I></TD><TD ALIGN="LEFT" PORT="atencion_id"><FONT POINT-SIZE="9" COLOR="#607D8B">BIGINT NN</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="tipo_l"> </TD><TD ALIGN="LEFT">tipo</TD><TD ALIGN="LEFT" PORT="tipo"><FONT POINT-SIZE="9" COLOR="#607D8B">VARCHAR(50) NN</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="estado_l"> </TD><TD ALIGN="LEFT">estado</TD><TD ALIGN="LEFT" PORT="estado"><FONT POINT-SIZE="9" COLOR="#607D8B">VARCHAR(20) NN</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="fecha_prevista_l"> </TD><TD ALIGN="LEFT">fecha_prevista</TD><TD ALIGN="LEFT" PORT="fecha_prevista"><FONT POINT-SIZE="9" COLOR="#607D8B">DATE</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="fecha_inicio_l"> </TD><TD ALIGN="LEFT">fecha_inicio</TD><TD ALIGN="LEFT" PORT="fecha_inicio"><FONT POINT-SIZE="9" COLOR="#607D8B">TIMESTAMPTZ</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="fecha_fin_l"> </TD><TD ALIGN="LEFT">fecha_fin</TD><TD ALIGN="LEFT" PORT="fecha_fin"><FONT POINT-SIZE="9" COLOR="#607D8B">TIMESTAMPTZ</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="motivo_no_realizada_l"> </TD><TD ALIGN="LEFT">motivo_no_realizada</TD><TD ALIGN="LEFT" PORT="motivo_no_realizada"><FONT POINT-SIZE="9" COLOR="#607D8B">TEXT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="observaciones_l"> </TD><TD ALIGN="LEFT">observaciones</TD><TD ALIGN="LEFT" PORT="observaciones"><FONT POINT-SIZE="9" COLOR="#607D8B">TEXT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="fecha_registro_l"> </TD><TD ALIGN="LEFT">fecha_registro</TD><TD ALIGN="LEFT" PORT="fecha_registro"><FONT POINT-SIZE="9" COLOR="#607D8B">TIMESTAMPTZ NN</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="eliminado_l"> </TD><TD ALIGN="LEFT">eliminado</TD><TD ALIGN="LEFT" PORT="eliminado"><FONT POINT-SIZE="9" COLOR="#607D8B">BOOLEAN NN</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="detalle_l"> </TD><TD ALIGN="LEFT">detalle</TD><TD ALIGN="LEFT" PORT="detalle"><FONT POINT-SIZE="9" COLOR="#607D8B">JSONB</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="tipo_id_l"><FONT POINT-SIZE="9" COLOR="#2E7D32"><B>FK</B></FONT></TD><TD ALIGN="LEFT"><I>tipo_id</I></TD><TD ALIGN="LEFT" PORT="tipo_id"><FONT POINT-SIZE="9" COLOR="#607D8B">BIGINT</FONT></TD></TR></TABLE>>];
