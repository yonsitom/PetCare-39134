"dietas" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white" COLOR="#6A1B9A"><TR><TD COLSPAN="3" BGCOLOR="#6A1B9A" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="13"><B>DIETAS</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="dieta_id_l"><FONT POINT-SIZE="9" COLOR="#6A1B9A"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><B><U>dieta_id</U></B></TD><TD ALIGN="LEFT" PORT="dieta_id"><FONT POINT-SIZE="9" COLOR="#607D8B">BIGINT NN</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="receta_id_l"><FONT POINT-SIZE="9" COLOR="#6A1B9A"><B>FK, UQ</B></FONT></TD><TD ALIGN="LEFT"><I>receta_id</I></TD><TD ALIGN="LEFT" PORT="receta_id"><FONT POINT-SIZE="9" COLOR="#607D8B">BIGINT NN</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="tipo_dieta_l"> </TD><TD ALIGN="LEFT">tipo_dieta</TD><TD ALIGN="LEFT" PORT="tipo_dieta"><FONT POINT-SIZE="9" COLOR="#607D8B">VARCHAR(100) NN</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="opciones_proteina_l"> </TD><TD ALIGN="LEFT">opciones_proteina</TD><TD ALIGN="LEFT" PORT="opciones_proteina"><FONT POINT-SIZE="9" COLOR="#607D8B">TEXT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="opciones_vegetales_l"> </TD><TD ALIGN="LEFT">opciones_vegetales</TD><TD ALIGN="LEFT" PORT="opciones_vegetales"><FONT POINT-SIZE="9" COLOR="#607D8B">TEXT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="restriccion_nutricional_l"> </TD><TD ALIGN="LEFT">restriccion_nutricional</TD><TD ALIGN="LEFT" PORT="restriccion_nutricional"><FONT POINT-SIZE="9" COLOR="#607D8B">TEXT</FONT></TD></TR></TABLE>>];
"servicios" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white" COLOR="#6A1B9A"><TR><TD COLSPAN="3" BGCOLOR="#6A1B9A" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="13"><B>SERVICIOS</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="servicio_id_l"><FONT POINT-SIZE="9" COLOR="#6A1B9A"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><B><U>servicio_id</U></B></TD><TD ALIGN="LEFT" PORT="servicio_id"><FONT POINT-SIZE="9" COLOR="#607D8B">BIGINT NN</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="actividad_id_l"><FONT POINT-SIZE="9" COLOR="#6A1B9A"><B>FK</B></FONT></TD><TD ALIGN="LEFT"><I>actividad_id</I></TD><TD ALIGN="LEFT" PORT="actividad_id"><FONT POINT-SIZE="9" COLOR="#607D8B">BIGINT NN</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="region_evaluada_l"> </TD><TD ALIGN="LEFT">region_evaluada</TD><TD ALIGN="LEFT" PORT="region_evaluada"><FONT POINT-SIZE="9" COLOR="#607D8B">VARCHAR(150)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="fecha_servicio_l"> </TD><TD ALIGN="LEFT">fecha_servicio</TD><TD ALIGN="LEFT" PORT="fecha_servicio"><FONT POINT-SIZE="9" COLOR="#607D8B">DATE NN</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="recomendaciones_l"> </TD><TD ALIGN="LEFT">recomendaciones</TD><TD ALIGN="LEFT" PORT="recomendaciones"><FONT POINT-SIZE="9" COLOR="#607D8B">TEXT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="conclusion_general_l"> </TD><TD ALIGN="LEFT">conclusion_general</TD><TD ALIGN="LEFT" PORT="conclusion_general"><FONT POINT-SIZE="9" COLOR="#607D8B">TEXT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="fecha_registro_l"> </TD><TD ALIGN="LEFT">fecha_registro</TD><TD ALIGN="LEFT" PORT="fecha_registro"><FONT POINT-SIZE="9" COLOR="#607D8B">TIMESTAMPTZ NN</FONT></TD></TR></TABLE>>];
"detalle_servicio" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white" COLOR="#6A1B9A"><TR><TD COLSPAN="3" BGCOLOR="#6A1B9A" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="13"><B>DETALLE_SERVICIO</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="detalle_servicio_id_l"><FONT POINT-SIZE="9" COLOR="#6A1B9A"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><B><U>detalle_servicio_id</U></B></TD><TD ALIGN="LEFT" PORT="detalle_servicio_id"><FONT POINT-SIZE="9" COLOR="#607D8B">BIGINT NN</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="servicio_id_l"><FONT POINT-SIZE="9" COLOR="#6A1B9A"><B>FK, UQ</B></FONT></TD><TD ALIGN="LEFT"><I>servicio_id</I></TD><TD ALIGN="LEFT" PORT="servicio_id"><FONT POINT-SIZE="9" COLOR="#607D8B">BIGINT NN</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="organo_id_l"><FONT POINT-SIZE="9" COLOR="#6A1B9A"><B>FK, UQ</B></FONT></TD><TD ALIGN="LEFT"><I>organo_id</I></TD><TD ALIGN="LEFT" PORT="organo_id"><FONT POINT-SIZE="9" COLOR="#607D8B">BIGINT NN</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="hallazgos_l"> </TD><TD ALIGN="LEFT">hallazgos</TD><TD ALIGN="LEFT" PORT="hallazgos"><FONT POINT-SIZE="9" COLOR="#607D8B">TEXT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="mediciones_especificas_l"> </TD><TD ALIGN="LEFT">mediciones_especificas</TD><TD ALIGN="LEFT" PORT="mediciones_especificas"><FONT POINT-SIZE="9" COLOR="#607D8B">TEXT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="conclusiones_sugeridas_l"> </TD><TD ALIGN="LEFT">conclusiones_sugeridas</TD><TD ALIGN="LEFT" PORT="conclusiones_sugeridas"><FONT POINT-SIZE="9" COLOR="#607D8B">TEXT</FONT></TD></TR></TABLE>>];
"organos_evaluados" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white" COLOR="#6A1B9A"><TR><TD COLSPAN="3" BGCOLOR="#6A1B9A" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="13"><B>ORGANOS_EVALUADOS</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="organo_id_l"><FONT POINT-SIZE="9" COLOR="#6A1B9A"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><B><U>organo_id</U></B></TD><TD ALIGN="LEFT" PORT="organo_id"><FONT POINT-SIZE="9" COLOR="#607D8B">BIGINT NN</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="nombre_organo_l"><FONT POINT-SIZE="9" COLOR="#6A1B9A"><B>UQ</B></FONT></TD><TD ALIGN="LEFT">nombre_organo</TD><TD ALIGN="LEFT" PORT="nombre_organo"><FONT POINT-SIZE="9" COLOR="#607D8B">VARCHAR(120) NN</FONT></TD></TR></TABLE>>];
}
"auth.users" [label=<<TABLE BORDER="1" CELLBORDER="0" STYLE="dashed" CELLPADDING="4" BGCOLOR="#ECEFF1"><TR><TD><B>AUTH.USERS</B></TD></TR><TR><TD PORT="id"><FONT POINT-SIZE="9">id (Supabase Auth)</FONT></TD></TR></TABLE>>];
